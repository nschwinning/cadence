# Cadence HTTPS entry point: the only way into Cadence from the network.
#
# CADENCE_HOSTNAME is the host name (or IP) users open, e.g. cadence.local or the
# Pi's address. `tls internal` serves certificates from Caddy's own local CA, kept
# in the `caddy_data` volume; trust its root certificate once per device (see
# docs/environments.md). Going public later: set CADENCE_HOSTNAME to the domain,
# remove `tls internal`, publish ports 80/443 — Caddy then obtains and renews
# publicly trusted certificates by itself.
{
	# Only the HTTPS port is published; no HTTP->HTTPS redirect listener needed.
	auto_https disable_redirects
}

{$CADENCE_HOSTNAME} {
	tls internal

	# Keycloak (identity provider), served under /auth on the same origin.
	handle /auth* {
		reverse_proxy keycloak:8080
	}

	# Backend API and health.
	handle /api* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else: the web application (Vite dev server, incl. its HMR websocket).
	handle {
		reverse_proxy frontend:5173
	}
}
