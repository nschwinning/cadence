# Copy to .env and adjust as needed. Docker Compose reads this automatically.

# --- PostgreSQL ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# --- Backend ---
# Inside the compose network the DB host is `db` on port 5432.
# (From the host machine, Postgres is published on localhost:5435.)
DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5435/cadence
# Dedicated database for the pytest suite (kept separate from dev/prod data).
# From the host machine, Postgres is published on localhost:5435.
TEST_DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5435/cadence_test
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5174

# --- AI asset recommender ---
# OpenAI API key for the recommendation agent (openai-agents SDK).
OPENAI_API_KEY=
# SerpAPI key for the agent's web_search tool.
SERP_API_KEY=
# Model id the recommender agent runs on.
RECOMMENDER_MODEL=gpt-5-mini
# Set to 1/true to use the offline stub recommender (canned candidates, no
# OpenAI/SerpAPI calls) for the Docker end-to-end smoke or local dev.
RECOMMENDER_STUB=true
# Wall-clock ceiling (seconds) for a single recommender run. Raise this if runs
# time out; each candidate is web-search-verified, so more assets need more time.
RECOMMENDER_AGENT_TIMEOUT_SECONDS=300
# Hard SDK-enforced turn cap per recommender run (bounds tool-call loops).
RECOMMENDER_MAX_TURNS=24

# --- AI portfolio / Alpaca paper trading ---
# Model id the AI portfolio manager runs on.
AI_PORTFOLIO_MODEL=gpt-5-mini
# Cost controls bounding each AI build/rebalance run.
# Hard SDK-enforced agent turn cap (bounds tool-call loops).
AI_PORTFOLIO_MAX_TURNS=8
# Hard cap on web searches per agent run (enforced in the web_search tool).
AI_PORTFOLIO_MAX_WEB_SEARCHES=6
# Max assets the agent may discover and add beyond the current universe.
AI_PORTFOLIO_MAX_NEW_ASSETS=5
# Alpaca paper-trading credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use Alpaca's paper-trading endpoint (never live). Keep true.
ALPACA_PAPER=true
# Set to 1/true to use the offline Alpaca stub (no network calls).
ALPACA_STUB=true
# Shared secret guarding the daily-rebalance trigger. The cron sidecar sends the
# same value in the X-Cron-Token header. Change this before enabling rebalances.
REBALANCE_CRON_TOKEN=changeme
# Cron schedules for the sidecar triggers (interpreted in the sidecar's TZ,
# default America/New_York). Rebalance just after the US open; ingest benchmark
# index closes just before the close; end-of-day value snapshot + P&L report just
# after the US close (benchmark runs first so the report compares fresh prices).
REBALANCE_SCHEDULE=35 9 * * 1-5
BENCHMARK_SCHEDULE=5 16 * * 1-5
SNAPSHOT_SCHEDULE=15 16 * * 1-5

# --- Push notifications (optional) ---
# Pushover credentials for daily-rebalance notifications (executed orders and
# failures). Leave either blank to silently disable notifications; the app still
# boots and rebalances normally. Get these from https://pushover.net.
PUSHOVER_USER=
PUSHOVER_TOKEN=
