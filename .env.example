# Copy to .env and adjust as needed. Docker Compose reads this automatically.

# --- PostgreSQL ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# --- Backend ---
# Inside the compose network the DB host is `db` on port 5432.
# (From the host machine, Postgres is published on localhost:5435.)
DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5435/cadence
# Dedicated database for the pytest suite (kept separate from dev/prod data).
# From the host machine, Postgres is published on localhost:5435.
TEST_DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5435/cadence_test
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5174

# --- AI asset recommender ---
# OpenAI API key for the recommendation agent (openai-agents SDK).
OPENAI_API_KEY=
# SerpAPI key for the agent's web_search tool.
SERP_API_KEY=
# Model id the recommender agent runs on.
RECOMMENDER_MODEL=gpt-5-mini
# Set to 1/true to use the offline stub recommender (canned candidates, no
# OpenAI/SerpAPI calls) for the Docker end-to-end smoke or local dev.
RECOMMENDER_STUB=true

# --- AI portfolio / Alpaca paper trading ---
# Model id the AI portfolio manager runs on.
AI_PORTFOLIO_MODEL=gpt-5-mini
# Alpaca paper-trading credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use Alpaca's paper-trading endpoint (never live). Keep true.
ALPACA_PAPER=true
# Set to 1/true to use the offline Alpaca stub (no network calls).
ALPACA_STUB=true
# Shared secret guarding the daily-rebalance trigger. The cron sidecar sends the
# same value in the X-Cron-Token header. Change this before enabling rebalances.
REBALANCE_CRON_TOKEN=changeme
