# API base URL for the axios client. Leave empty to use same-origin relative
# requests through the Vite dev proxy (the default and recommended setup).
VITE_API_URL=

# Dev proxy target used by vite.config.ts. Defaults to the Docker Compose
# service name (http://backend:8000). For a local, non-Docker backend, set:
# VITE_PROXY_TARGET=http://localhost:8002
VITE_PROXY_TARGET=
