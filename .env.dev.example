# DEV environment — copy to `.env` in the DEV checkout (e.g. ~/apps/cadence-dev).
# DEV runs next to QA on the same host: Alpaca is fully MOCKED, it uses its own
# ports, database volume and network (compose names the project after the
# directory), and AI runs only when you start them by hand.
# See docs/environments.md.

# --- Environment ---
CADENCE_ENVIRONMENT=DEV
# Compose project name: keeps DEV's containers, database volume and network apart
# from QA's, independent of the directory name. Never change it on an existing
# environment (a new name means a new, empty database volume).
COMPOSE_PROJECT_NAME=cadence-dev

# --- Published ports (must differ from QA's defaults 5435 / 4000 / 8002 / 5174) ---
DB_HOST_PORT=5436
LITELLM_HOST_PORT=4001
BACKEND_HOST_PORT=8003
FRONTEND_HOST_PORT=5175

# --- HTTPS entry point (Caddy) & login (Keycloak) ---
# The address users open: Caddy serves HTTPS on CADDY_HTTPS_PORT for CADENCE_HOSTNAME
# (the Pi's host name or IP) and is the only way in from the network.
CADENCE_HOSTNAME=cadence.local
CADDY_HTTPS_PORT=9443
CADENCE_PUBLIC_URL=https://cadence.local:9443
# Every /api/v1 route requires a Keycloak login. false ONLY for local development.
AUTH_ENABLED=true
# Optional: expected token issuer; empty = {CADENCE_PUBLIC_URL}/auth/realms/cadence.
OIDC_ISSUER=
# Keycloak's own admin (admin console at {CADENCE_PUBLIC_URL}/auth/admin). It only
# manages Keycloak and cannot use Cadence. Created on Keycloak's first start.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
# Optional one-time seed of a Cadence admin (role `admin`) on first setup; the
# password is temporary — you choose a new one at first login. Never repeated.
CADENCE_ADMIN_USERNAME=
CADENCE_ADMIN_PASSWORD=

# --- PostgreSQL (DEV's own volume; data is disposable) ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence
DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5436/cadence
TEST_DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5436/cadence_test
CORS_ORIGINS=https://cadence.local:9443

# --- Alpaca: MOCKED. Never put Alpaca keys in a DEV file. ---
# The stub replaces orders, positions, quotes, the market clock, tradability
# checks, bot bars and news; with no keys nothing can reach a real account.
ALPACA_STUB=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_ALLOW_LIVE=false

# --- AI: real, but on a SEPARATE low-limit key / budget ---
# Use a dedicated OpenAI project key with a small monthly limit (or a LiteLLM
# virtual key with a budget) so DEV experiments can never run up the QA bill.
OPENAI_API_KEY=
WEB_SEARCH_PROVIDER=serpapi
SERP_API_KEY=
SERPER_API_KEY=
RECOMMENDER_MODEL=gpt-5-mini
RECOMMENDER_STUB=false
AI_PORTFOLIO_MODEL=gpt-5-mini
AI_PORTFOLIO_MAX_TURNS=8
AI_PORTFOLIO_MAX_WEB_SEARCHES=6
AI_PORTFOLIO_MAX_NEW_ASSETS=5
NEWS_HEADLINES_PER_TICKER=3
NEWS_HEADLINES_WINDOW_DAYS=3

# --- Cron ---
# The sidecar needs a token; the daily AI jobs are PARKED (Feb 31 never comes),
# so DEV only spends AI money when you trigger a run by hand. Bot ticks and
# snapshots stay on — they only hit the stub.
REBALANCE_CRON_TOKEN=change-me-dev
REBALANCE_SCHEDULE=0 0 31 2 *
CRYPTO_REBALANCE_SCHEDULE=0 0 31 2 *
ORCHESTRATOR_SCHEDULE=0 0 31 2 *
BENCHMARK_SCHEDULE=5 16 * * 1-5
SNAPSHOT_SCHEDULE=15 16 * * *

# --- Push notifications ---
# Leave blank, or use a separate Pushover application so DEV pushes are
# never mistaken for QA / PRD ones.
PUSHOVER_USER=
PUSHOVER_TOKEN=
